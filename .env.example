# ---- Compose / порты (хост) -----------------------------------------------
COMPOSE_PROJECT_NAME=insolvencyhub
API_HOST_PORT=20500
POSTGRES_HOST_PORT=20501
REDIS_HOST_PORT=20502

# ---- Postgres / Redis -----------------------------------------------------
POSTGRES_USER=ih
POSTGRES_PASSWORD=change-me
POSTGRES_DB=insolvency_hub
REDIS_PASSWORD=change-me

# ---- Приложение (сеть compose: postgres/redis) ----------------------------
IH_ENV=dev
IH_DATABASE_URL=postgresql+asyncpg://ih:change-me@postgres:5432/insolvency_hub
IH_REDIS_URL=redis://:change-me@redis:6379/0
IH_PASETO_KEY_HEX=change-me
IH_TOKEN_TTL_MINUTES=60
IH_REMINDER_HORIZON_DAYS=5
IH_LOG_JSON=true
IH_DEMO_PASSWORD=demo-password

# ---- Тесты (make test) ------------------------------------------------------
IH_TEST_DATABASE_URL=postgresql+asyncpg://ih:change-me@postgres:5432/insolvency_hub_test
IH_TEST_REDIS_URL=redis://:change-me@redis:6379/15
